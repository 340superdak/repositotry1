# Copy to .env and fill in to run against a real store. Leave everything
# blank to run entirely on the built-in mock fixtures (src/mocks/fixtures.ts).

# --- Shopify Admin API ---
# Custom app access token with at least: read_products, read_content, read_themes, write_themes
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01

# --- Google Analytics 4 ---
GA4_PROPERTY_ID=
# Path to a GA4-read-scoped service account JSON key file
GA4_SERVICE_ACCOUNT_JSON=

# --- Safety ---
# Theme changes are only ever written to a theme with this role. Must be
# "unpublished" or "development" -- "live" is rejected at startup.
TARGET_THEME_ROLE=unpublished

# --- Misc ---
DATA_DIR=./data
DEFAULT_LOOKBACK_DAYS=28
# Optional Slack/Teams-style incoming webhook for scheduled-audit notifications
NOTIFY_WEBHOOK_URL=
# Cron expression for the standalone scheduler (npm run schedule)
AUDIT_CRON_SCHEDULE=0 6 * * *
