<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Zebra ZP 450 Printer</title>
    <organization>org.zp450</organization>
    <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>

    <!-- macOS 11 is the floor because the binaries are built with
         -mmacosx-version-min=11.0. -->
    <volume-check>
        <allowed-os-versions>
            <os-version min="11.0"/>
        </allowed-os-versions>
    </volume-check>

    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <pkg-ref id="org.zp450.printer"/>
    <choices-outline>
        <line choice="default">
            <line choice="org.zp450.printer"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="org.zp450.printer" visible="false">
        <pkg-ref id="org.zp450.printer"/>
    </choice>
    <pkg-ref id="org.zp450.printer" version="0" onConclusion="none">zp450-component.pkg</pkg-ref>
</installer-gui-script>
